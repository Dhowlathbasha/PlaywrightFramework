{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "Plywright Framework",
  "main": "index.js",
  "scripts": {
    "test:weblighthouse": "node ./src/test/qualitycheck/WebLighthouse.mjs",
    "test:mobilelighthouse": "node ./src/test/qualitycheck/MobileLighthouse.mjs",

    "//comment": "============================= API Testing  ===================================",
    "test:qa:api": "cross-env NODE_ENV='qa' npx playwright test --trace on ./src/test/scriptLibrary/api",
    "test:dev:api": "cross-env NODE_ENV='dev' npx playwright test --trace on ./src/test/scriptLibrary/api",
    "test:local:api": "cross-env NODE_ENV='dev' npx playwright test --trace on ./src/test/scriptLibrary/api",

    "//comment1": "============================= UI Testing  ===================================",
    "test:qa:ui": "cross-env NODE_ENV='qa' npx playwright test --trace on ./src/test/scriptLibrary/ui",
    "test:dev:ui": "cross-env NODE_ENV='dev' npx playwright test --trace on ./src/test/scriptLibrary/ui",
    "test:local:ui": "cross-env NODE_ENV='dev' npx playwright test --trace on ./src/test/scriptLibrary/ui",

    "//comment3": "============================= Allure Report Generation =================================",
    "test:allure_report_generation": "allure generate ./reports/allure-results -o ./reports/allure-report --clean && allure open ./reports/allure-report"

  },
  "author": "DhowlathBasha",
  "license": "ISC",
  "dependencies": {
    "@axe-core/playwright": "^4.8.5",
    "adm-zip": "^0.5.10",
    "archiver": "^6.0.1",
    "dotenv": "^16.4.4",
    "exceljs": "^4.4.0",
    "lighthouse": "^11.5.0",
    "moment": "^2.30.1",
    "pdfjs-dist-es5": "^2.13.216",
    "playwright": "^1.41.1",
    "reflect-metadata": "^0.2.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.8.0",
    "v8-to-istanbul": "^9.2.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.2",
    "@types/adm-zip": "^0.5.5",
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.11.16",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "allure-playwright": "^2.12.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
